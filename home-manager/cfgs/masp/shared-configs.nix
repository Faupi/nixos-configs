{
  clipboard-actions.enable = true;
  command-not-found.enable = true;
  dank-material-shell.enable = true;
  easyeffects.enable = true;
  konsole.enable = true;

  dolphin = {
    enable = true;
    setAsDefault = true;
  };

  gwenview = {
    enable = true;
    setAsDefault = true;
  };

  spotify = {
    enable = true;
    autoStart = true;
  };

  vivaldi = {
    enable = true;
    setAsDefault = false;
  };

  vscodium = {
    enable = true;
    setAsDefault = true;
    folderHandling.enable = true;
  };

  teams = {
    enable = true;
    autoStart = {
      enable = true;
      minimized = false;
    };
  };

  zen = {
    enable = true;
    setAsDefault = true;
  };
}
